# ── Core ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyto?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"

# ── Tokens ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-production"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# ── OTP ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Separate from JWT_SECRET. openssl rand -base64 48
OTP_PEPPER="change-me-in-production"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

# Development only — ignored when NODE_ENV=production.
# Fixed codes for specific destinations, so you can test without spending SMS.
# Format: <destination>:<code>,<destination>:<code>
# OTP_TEST_DESTINATIONS="+919876543210:123456,dev@nyto.app:123456"

# ── SMS delivery ───────────────────────────────────────────────────────────
# Country calling codes routed to MSG91. Everything else goes to Twilio.
MSG91_COUNTRY_CODES="91"

# MSG91 (India). Requires TRAI DLT entity + sender ID + template registration.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Twilio (rest of world). TWILIO_FROM is an E.164 number or a Messaging
# Service SID starting with "MG".
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Android SMS Retriever app hash, appended as the last line of the OTP SMS so
# Android can hand the code to the app with no SMS permission. Leave blank to
# rely on the SMS User Consent API instead. Debug and release builds differ.
ANDROID_SMS_APP_HASH=""

# ── Email OTP ──────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="NYTO <onboarding@your-domain.com>"

# ── Social sign-in ─────────────────────────────────────────────────────────
# Every Google OAuth client ID that can mint an ID token for this app
# (Web + Android + iOS), comma-separated. Used as the accepted audiences.
GOOGLE_CLIENT_IDS=""

# Apple: iOS bundle ID(s) and/or Services ID(s), comma-separated.
APPLE_CLIENT_IDS="com.nyto.nytoApp"

# Facebook Login. The secret stays server-side only.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ── Product config ─────────────────────────────────────────────────────────
TABLE_EVENT_DURATION_HOURS=4
TABLE_CHAT_GRACE_PERIOD_HOURS=72
