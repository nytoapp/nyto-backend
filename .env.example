# Environment
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyto?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="*"

# Resend email OTP (optional in development, required for real inbox delivery)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="NYTO <onboarding@your-domain.com>"

# Dev OTP is 000000 when NODE_ENV=development and RESEND_API_KEY is not set.

# Comma-separated Google OAuth client IDs (Web + Android). Used to verify ID tokens.
GOOGLE_CLIENT_IDS=""

