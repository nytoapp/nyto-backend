generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  PHONE
  GOOGLE
  EMAIL
  APPLE
  FACEBOOK
}

/// Platform role. Never trust a client-supplied role — always load from DB.
enum UserRole {
  USER
  VENUE_STAFF
  ADMIN
}

/// Role of a staff member within a single venue tenant.
enum VenueStaffRole {
  OWNER
  MANAGER
  STAFF
}

enum OtpChannel {
  SMS
  EMAIL
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum IdDocumentType {
  PAN
  AADHAAR
  DRIVING_LICENCE
  PASSPORT
}

enum DietaryPreference {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
}

enum BookingType {
  SOLO
  GROUP
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  UNKNOWN
}

enum PaymentProvider {
  /// Local stub until Razorpay (or similar) is wired.
  STUB
  RAZORPAY
}

enum TableStatus {
  OPEN
  MATCHING
  AWAITING_REVIEW
  APPROVED
  REVEALED
  COMPLETED
  CANCELLED
}

enum PriceTier {
  DAYTIME
  EVENING
}

enum GenderPreference {
  BALANCED
  WOMEN_ONLY
}

enum DirectThreadStatus {
  PENDING
  ACTIVE
  DECLINED
}

model User {
  id                 String             @id @default(cuid())
  phone              String?            @unique
  googleId           String?            @unique
  appleId            String?            @unique
  facebookId         String?            @unique
  email              String?            @unique
  authProvider       AuthProvider
  /// Platform privilege. Default consumer; elevated only via admin tooling/seed.
  role               UserRole           @default(USER)
  firstName          String?
  fullName           String             @default("")
  dateOfBirth        DateTime?
  gender             String?
  /// introverted | ambiverted | extroverted
  socialEnergy       String?
  interests          String[]           @default([])
  isAgeVerified      Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  attendanceCount    Int                @default(0)
  currentStreak      Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  profile            CompatibilityProfile?
  identityChecks     IdentityVerification[]
  bookings           Booking[]
  groupMemberships   BookingGroupMember[]
  tableMemberships   TableMember[]
  chatMessages       ChatMessage[]
  dmLow              DirectThread[]         @relation("DmLow")
  dmHigh             DirectThread[]         @relation("DmHigh")
  dmMessages         DirectMessage[]
  blocks             UserBlock[]            @relation("Blocker")
  blockedBy          UserBlock[]            @relation("Blocked")
  connectionSignals  ConnectionSignal[]     @relation("FromUser")
  receivedSignals    ConnectionSignal[]     @relation("ToUser")
  badges             UserBadge[]
  authSessions       AuthSession[]
  venueStaff         VenueStaff[]

  @@map("users")
}

/// Short-lived one-time code. The code itself is never stored — only a keyed hash.
model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  /// E.164 phone or normalized email.
  destination String
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  /// Number of times a code was delivered for this challenge (initial send + resends).
  sendCount   Int        @default(1)
  expiresAt   DateTime
  lastSentAt  DateTime   @default(now())
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([channel, destination, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// Refresh-token session. Rotated on every refresh; only a hash is persisted.
model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  /// Set when this session was rotated, pointing at its replacement.
  replacedById     String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model IdentityVerification {
  id           String             @id @default(cuid())
  userId       String
  documentType IdDocumentType
  documentUrl  String
  selfieUrl    String
  status       VerificationStatus @default(SUBMITTED)
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

model CompatibilityProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  energyLevel        Int
  humorStyle         Int
  conversationDepth  Int
  opennessToNew      Int
  adventurousness    Int
  dietaryPreference  DietaryPreference
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("compatibility_profiles")
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  /// Neighbourhood within the city (e.g. Madhapur). Used for Home area filters.
  area        String?
  lat         Float?
  lng         Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menus  VenueMenu[]
  tables SupperTable[]
  staff  VenueStaff[]

  @@index([city, area])
  @@map("venues")
}

/// Links a user to a venue they may manage. Tenant scope always comes from here,
/// never from a client-supplied venueId claim alone.
model VenueStaff {
  id        String         @id @default(cuid())
  userId    String
  venueId   String
  staffRole VenueStaffRole @default(STAFF)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId, isActive])
  @@index([userId, isActive])
  @@map("venue_staff")
}

model VenueMenu {
  id           String            @id @default(cuid())
  venueId      String
  name         String
  description  String?
  dietaryType  DietaryPreference
  costPerHead  Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  venue  Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables SupperTable[]

  @@map("venue_menus")
}

/// A scheduled table night (up to 6 seats).
model SupperTable {
  id                String           @id @default(cuid())
  venueId           String
  menuId            String?
  startsAt          DateTime
  /// When guests may pay/book. Before this, table is visible but locked.
  bookingOpensAt    DateTime
  priceTier         PriceTier
  seatPrice         Int
  status            TableStatus      @default(OPEN)
  genderPreference  GenderPreference @default(BALANCED)
  capacity          Int              @default(6)
  reviewedBy        String?
  reviewedAt        DateTime?
  revealedAt        DateTime?
  icebreakers       String[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  venue    Venue           @relation(fields: [venueId], references: [id])
  menu     VenueMenu?      @relation(fields: [menuId], references: [id])
  bookings Booking[]
  members  TableMember[]
  messages ChatMessage[]

  @@index([bookingOpensAt])
  @@map("supper_tables")
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  tableId         String
  bookingType     BookingType   @default(SOLO)
  status          BookingStatus @default(PENDING_PAYMENT)
  seatsBooked     Int           @default(1)
  amountPaid      Int?
  paidAt          DateTime?
  /// Legacy short ref kept for older clients; prefer Payment.providerRef.
  paymentRef      String?
  /// Short code shown / QR'd at the venue door after payment.
  checkInCode     String?       @unique
  checkedInAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User                 @relation(fields: [userId], references: [id])
  table   SupperTable          @relation(fields: [tableId], references: [id])
  members BookingGroupMember[]
  payment Payment?

  @@index([tableId, status])
  @@index([userId, status])
  @@map("bookings")
}

/// Ledger row for money against a booking. PSP details live here so admin/venue
/// can see payment state without trusting the client.
model Payment {
  id           String          @id @default(cuid())
  bookingId    String          @unique
  amount       Int
  currency     String          @default("INR")
  status       PaymentStatus   @default(PENDING)
  method       PaymentMethod   @default(UNKNOWN)
  provider     PaymentProvider @default(STUB)
  providerRef  String?
  capturedAt   DateTime?
  refundedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payments")
}

model BookingGroupMember {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@map("booking_group_members")
}

model TableMember {
  id                 String   @id @default(cuid())
  tableId            String
  userId             String
  oneLineDescription String?
  attended           Boolean  @default(false)
  attendedAt         DateTime?
  createdAt          DateTime @default(now())

  table SupperTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id])

  @@unique([tableId, userId])
  @@map("table_members")
}

model ChatMessage {
  id               String   @id @default(cuid())
  tableId          String
  senderId         String
  body             String
  /// Client-generated id for send idempotency (optional).
  clientMessageId  String?
  createdAt        DateTime @default(now())

  table  SupperTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderId], references: [id])

  @@index([tableId, createdAt])
  @@index([tableId, clientMessageId])
  @@map("chat_messages")
}

/// 1-to-1 thread. PENDING = message request until the other person accepts or replies.
model DirectThread {
  id            String              @id @default(cuid())
  userLowId     String
  userHighId    String
  initiatedById String
  status        DirectThreadStatus  @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  userLow  User            @relation("DmLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User            @relation("DmHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@map("direct_threads")
}

model DirectMessage {
  id              String   @id @default(cuid())
  threadId        String
  senderId        String
  body            String
  clientMessageId String?
  createdAt       DateTime @default(now())

  thread DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, clientMessageId])
  @@map("direct_messages")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

/// One-way private interest. Connection only if mutual.
model ConnectionSignal {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  tableId    String
  createdAt  DateTime @default(now())

  fromUser User @relation("FromUser", fields: [fromUserId], references: [id])
  toUser   User @relation("ToUser", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId, tableId])
  @@map("connection_signals")
}

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}
